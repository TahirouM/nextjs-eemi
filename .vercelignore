# Dépendances et artefacts : Vercel les reconstruit lui-même.
node_modules
.next

# Tests de bout en bout : ils pilotent un navigateur, inutiles au déploiement.
tests

# Documents de travail
*.pdf

# Fichiers d'environnement locaux.
# IMPORTANT : .vercelignore n'hérite PAS de .gitignore. Sans ces lignes, le
# .env local (qui pointe vers localhost) est envoyé et ÉCRASE les variables
# définies sur Vercel — le build échoue alors sur une base injoignable.
.env
.env.*
!.env.example
