# ─── Base de données ───────────────────────────────────────────────────────
# Connexion applicative. En production (Neon, Supabase), c'est l'URL du POOLER.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5440/clubsport?schema=public"

# Connexion DIRECTE, sans pooler : utilisée uniquement par `prisma migrate`.
# Les poolers en mode transaction ne gèrent pas les verrous de migration.
# En local, mettez la même valeur que DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5440/clubsport?schema=public"

# ─── Sécurité ──────────────────────────────────────────────────────────────
# Clé de signature des cookies de session — 32 caractères MINIMUM.
# Générez la vôtre, ne réutilisez jamais cette valeur d'exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="remplacez-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum"

# ─── URL publique ──────────────────────────────────────────────────────────
# Sert aux metadata, au sitemap et aux balises Open Graph.
# En production : https://votre-projet.vercel.app
# NEXT_PUBLIC_SITE_URL="https://clubsport.example.com"
