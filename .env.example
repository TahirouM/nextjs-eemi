# Connexion PostgreSQL.
# Docker local : voir la commande `docker run` du README (port 5440).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5440/clubsport?schema=public"

# Clé de signature des cookies de session — 32 caractères MINIMUM.
# Générez la vôtre, ne réutilisez jamais cette valeur d'exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="remplacez-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum"

# URL publique du site (metadata, sitemap, Open Graph). Optionnel en local.
# NEXT_PUBLIC_SITE_URL="https://clubsport.example.com"
